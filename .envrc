# Load nvm if it exists
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh"
  if [ -f .nvmrc ]; then
    nvm use || nvm install
  fi
elif has fnm; then
  eval "$(fnm env --use-on-cd)"
  if [ -f .nvmrc ]; then
    fnm use || fnm install
  fi
fi

# Automatically add node_modules/.bin to PATH
layout node
